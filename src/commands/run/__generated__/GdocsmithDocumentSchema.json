{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "documentId": {
      "type": "string",
      "description": "Document ID (raw id, not a URL). Auto-opens as alias `main` when set."
    },
    "dryRun": {
      "type": "boolean",
      "description": "Preview resolved targets without writing."
    },
    "force": {
      "type": "boolean",
      "description": "Skip guards. Only if the user asked."
    },
    "json": {
      "type": "boolean",
      "description": "Output JSON instead of YAML."
    },
    "ops": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/GdocsmithStepInput"
      },
      "description": "Alias for `steps`."
    },
    "quiet": {
      "type": "boolean",
      "description": "Minimal output."
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/GdocsmithStepInput"
      },
      "description": "Ordered workflow steps."
    }
  },
  "additionalProperties": false,
  "definitions": {
    "GdocsmithStepInput": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "description": "Alias for `kind`."
        },
        "after": {
          "type": ["number", "string"],
          "description": "Anchor node to insert after."
        },
        "as": {
          "type": "string",
          "description": "Label for later steps in this document."
        },
        "at": {
          "type": ["number", "string"],
          "description": "Heading-scoped id from query (e.g. h.arch.9a1b)."
        },
        "before": {
          "type": ["number", "string"],
          "description": "Anchor node to insert before."
        },
        "contains": {
          "type": "string",
          "description": "Text substring filter for query."
        },
        "copyFrom": {
          "type": "string",
          "description": "Source doc ID or alias for copyDoc."
        },
        "dangerousClear": {
          "type": "boolean",
          "description": "Clear the tab/doc before mutations."
        },
        "dangerousRemoveSection": {
          "type": "boolean",
          "description": "Remove the heading and its following section."
        },
        "doc": {
          "type": "string",
          "description": "Target document ID or alias."
        },
        "docId": {
          "type": "string",
          "description": "Alias for doc."
        },
        "element": {
          "type": "object",
          "additionalProperties": {},
          "description": "Detached element spec to insert."
        },
        "elements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": {}
          },
          "description": "Detached element specs to insert in order."
        },
        "file": {
          "type": "string",
          "description": "Local markdown/text path."
        },
        "find": {
          "type": "string",
          "description": "String to find for replaceText."
        },
        "h1IsTitle": {
          "type": "boolean",
          "description": "Treat top-level # as Title instead of HEADING_1."
        },
        "index": {
          "type": "number",
          "description": "Position index for addTab."
        },
        "innerText": {
          "type": "string",
          "description": "In-place paragraph text."
        },
        "insertMarkdown": {
          "type": ["string", "boolean"],
          "description": "Insert rendered markdown at the anchor."
        },
        "kind": {
          "type": "string",
          "description": "Step kind: open, close, createDoc, copyDoc, query, dump, insertMarkdown, …"
        },
        "markdown": {
          "type": "string",
          "description": "Markdown text string."
        },
        "op": {
          "type": "string",
          "description": "Alias for `kind`."
        },
        "permanent": {
          "type": "boolean",
          "description": "Permanently delete document (deleteDoc)."
        },
        "remove": {
          "type": "boolean",
          "description": "Delete this node."
        },
        "replace": {
          "type": "string",
          "description": "In-place text replacement (alias for innerText) or replaceText replacement."
        },
        "replaceMarkdown": {
          "type": ["string", "boolean"],
          "description": "Replace one node with markdown."
        },
        "replaceSection": {
          "type": ["string", "boolean"],
          "description": "Diff-replace a heading section with markdown."
        },
        "step": {
          "type": "string",
          "description": "Alias for `kind`."
        },
        "style": {
          "type": "object",
          "additionalProperties": {},
          "description": "Native style fields."
        },
        "stylesOnly": {
          "type": "boolean",
          "description": "Scope query to custom styled nodes only."
        },
        "tab": {
          "type": "string",
          "description": "Target tab ID or title."
        },
        "tabId": {
          "type": "string",
          "description": "Alias for tab."
        },
        "target": {
          "type": "string",
          "description": "Dump target alias (kind: dump)."
        },
        "text": {
          "type": "string",
          "description": "Text content for insertMarkdown / replace."
        },
        "title": {
          "type": "string",
          "description": "Title for createDoc / copyDoc / addTab / renameDoc / renameTab."
        },
        "under": {
          "type": "string",
          "description": "Heading or scope for query/replace."
        },
        "unsafeOnly": {
          "type": "boolean",
          "description": "Scope query to fragile nodes only."
        }
      },
      "additionalProperties": {},
      "description": "One workflow step. Canonical discriminator is `kind`; `action`, `op`, and `step` are accepted aliases."
    }
  }
}
